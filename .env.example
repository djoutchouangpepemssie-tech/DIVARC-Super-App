# =============================================================================
# DIVARC — Frontend Next.js. Copier en `.env.local` pour le dev local.
# Sur Railway : définir ces variables dans l'onglet Variables du service "web".
# =============================================================================

# URL du backend Python (FastAPI) pour le proxy HTTP /api/* (rewrite Next.js).
# Local : http://127.0.0.1:8000 · Prod : https://divarc-api.up.railway.app
BACKEND_URL=http://127.0.0.1:8000

# URL WebSocket du backend pour le temps réel (messagerie + présence).
# Le navigateur s'y connecte directement (pas via le proxy).
# Local : laisser vide (fallback auto vers ws://<host>:8000).
# Prod : wss://divarc-api.up.railway.app
NEXT_PUBLIC_WS_URL=
