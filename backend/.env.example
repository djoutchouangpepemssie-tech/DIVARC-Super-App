# =============================================================================
# DIVARC — Backend Python (FastAPI). Copier en `.env` pour le dev local.
# Sur Railway : définir ces variables dans l'onglet Variables du service backend.
# =============================================================================

# --- Base MongoDB (OBLIGATOIRE) ---
# Local (Docker) : mongodb://localhost:27017
# Railway : ajouter un service MongoDB puis référencer  MONGO_URL=${{MongoDB.MONGO_URL}}
MONGO_URL=mongodb://localhost:27017
DB_NAME=divarc

# --- Assistant IA « DIVA » (optionnel — sinon /api/ai/chat renvoie 503) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5-20250929

# --- E-mails OTP via Resend (optionnel — sinon OTP en mode preview) ---
RESEND_API_KEY=
RESEND_FROM=DIVARC <onboarding@resend.dev>

# --- Géolocalisation (optionnel — sinon fallback Nominatim) ---
GEOAPIFY_API_KEY=

# --- CORS ---
# Avec le proxy Next.js (rewrites), le front et le back sont same-origin : "*" suffit.
# Si le front appelle DIRECTEMENT le backend, mettre l'URL exacte du front.
CORS_ORIGINS=*

# --- URL publique du front (pour les QR de paiement scannables par appareil photo) ---
# Le QR encode APP_URL/?pay=CODE. Défaut : https://www.divarc.fr
APP_URL=https://www.divarc.fr
